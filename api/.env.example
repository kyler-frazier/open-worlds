# Local development configuration. Copy to `.env` and fill in. For running the
# api/worker directly against a local Postgres; the deploy has its own .env.

# --- Secrets (the app refuses to start without these) ---
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PLATFORM_SESSION_SECRET=
# Generate: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PLATFORM_FERNET_KEY=
# Required on every /api/internal/* call. internal-api shares a network with
# untrusted world containers, so there is no empty default.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PLATFORM_INTERNAL_SECRET=

# --- Google OAuth ---
PLATFORM_GOOGLE_CLIENT_ID=
PLATFORM_GOOGLE_CLIENT_SECRET=
PLATFORM_OAUTH_REDIRECT_BASE=https://games.example.com
# Space- or comma-separated Google `sub` values seeded as admins.
PLATFORM_ADMIN_GOOGLE_SUBS=

# --- Database ---
PLATFORM_DATABASE_URL=postgresql+psycopg://games:CHANGE_ME@db:5432/games

# --- Web / domains ---
PLATFORM_WEB_ORIGIN=https://games.example.com
# One wildcard domain for every world. mc-router routes Minecraft by it; for
# Palworld it is only a memorable address (the port picks the world).
PLATFORM_SERVERS_DOMAIN=servers.example.com

# --- Games ---
# Games are offered from the web UI (Admin > Settings > Games), and only while
# their router runs. Running the api directly, list the profiles that are up.
# PLATFORM_COMPOSE_PROFILES=minecraft,palworld
# Card artwork: <game>.webp/.png/... in this directory, or
# PLATFORM_GAME_ART_<GAME>=file for one game. See deploy/game-art/README.md.
# PLATFORM_GAME_ART_DIR=

# --- Game ports (Palworld) ---
# One port per world, and so the cap on Palworld worlds. Must match the range
# pal-waker publishes in the deploy's docker-compose.yml.
PLATFORM_GAME_PORT_RANGE_START=8211
PLATFORM_GAME_PORT_RANGE_END=8220

# --- Docker orchestration ---
PLATFORM_DOCKER_HOST=tcp://docker-socket-proxy:2375
# One network shared by every world container.
PLATFORM_GAMES_NETWORK=games
PLATFORM_WORLDS_DIR=/srv/games/worlds
PLATFORM_BACKUP_STAGING_DIR=/srv/games/backup-staging
PLATFORM_RUNTIME_CONFIG_PATH=/srv/games/platform-config/settings.json

# --- Filesystem ownership ---
# uid/gid of the api, worker and every world container; must own
# PLATFORM_WORLDS_DIR.
PLATFORM_RUN_UID=1000
PLATFORM_RUN_GID=1000

# --- World defaults ---
# Bounds on a world's memory: over the ceiling the host oversubscribes, under
# the floor a world is too starved to boot.
PLATFORM_MAX_MEMORY_MB=32768
PLATFORM_MIN_MEMORY_MB=1024
# A new world's memory is normally per game (GameAdapter.default_memory_mb):
# Minecraft's is reserved by the JVM at boot, Palworld's is only a ceiling.
# Uncomment to force one figure on every game.
# PLATFORM_DEFAULT_MEMORY_MB=8192
PLATFORM_MAX_WORLDS_PER_USER=5
# Total MB for world containers at once; a start past it is refused. Unset = no
# budget. Size to physical RAM minus the control plane, database and OS (~4 GB).
# PLATFORM_HOST_MEMORY_BUDGET_MB=24576
# CPU cores per world container (fractional allowed); 0 = uncapped.
PLATFORM_CONTAINER_CPUS=0

# Palworld only: recover from a backwards clock step
# (Pal.AllowNegativeDeltaTime=1) instead of segfaulting. Only for a host whose
# clock steps back. Applies when a world's container is next created.
PLATFORM_PALWORLD_ALLOW_NEGATIVE_DELTA_TIME=false
PLATFORM_DEFAULT_MAX_PLAYERS=16

# --- Sleep / wake ---
# Idle seconds before a world is put to sleep.
PLATFORM_AUTO_STOP_AFTER_SECONDS=600
# Seconds after a start or wake before the idle timer may fire, so a booting
# world is not put straight back to sleep.
PLATFORM_WAKE_GRACE_SECONDS=180
