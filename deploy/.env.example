# Copy to .env (mode 600) and replace every CHANGE_ME. The placeholders let
# compose interpolate the copy; `make preflight` refuses to start while any
# remain.
#
# Sections: secrets, sign-in and domains, the host, worlds, the egress guard,
# then one per game. A commented-out line shows a variable's default; uncomment
# it only to change it. `.env` is git-ignored.

# ==========================================================================
# Secrets
# ==========================================================================

# The superuser: held only by the db and db-init containers.
POSTGRES_USER=games
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=games
# The roles db-init creates (db/roles.sql): the schema owner, used only to
# migrate, and the row-only role the app services connect as.
POSTGRES_OWNER_PASSWORD=CHANGE_ME_strong_password
POSTGRES_APP_PASSWORD=CHANGE_ME_strong_password

# Handed out per service by docker-compose.yml: api gets the session secret,
# Fernet key and OAuth client; worker the Fernet key and OAuth client;
# internal-api the internal secret and Fernet key. No container sees the rest.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PLATFORM_SESSION_SECRET=CHANGE_ME
# Generate: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PLATFORM_FERNET_KEY=CHANGE_ME
# Rotation only (RUNBOOK "Rotating keys"): previous values, comma separated,
# still accepted while cookies and stored secrets move to the current one.
# PLATFORM_SESSION_OLD_SECRETS=
# PLATFORM_FERNET_OLD_KEYS=
# Each game's router authenticates to internal-api with this. internal-api
# shares the `games` network with every world container, so this secret is
# what stops a compromised game server from waking or sleeping other worlds.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PLATFORM_INTERNAL_SECRET=CHANGE_ME
# Shared secret between api/worker and the process that holds the Docker
# credential. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PLATFORM_WORLD_MANAGER_SECRET=CHANGE_ME
# Grafana's own admin account. Admins normally reach Grafana through the web
# UI (Admin > Metrics) and never use it.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Discord incoming webhook for alerts. Channel Settings -> Integrations ->
# Webhooks -> New Webhook -> Copy Webhook URL. This is a credential: anyone with
# it can post to that channel, so treat it like a password.
ALERT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# ==========================================================================
# Sign-in and domains
# ==========================================================================

PLATFORM_GOOGLE_CLIENT_ID=CHANGE_ME
PLATFORM_GOOGLE_CLIENT_SECRET=CHANGE_ME
PLATFORM_OAUTH_REDIRECT_BASE=https://games.example.com
# Space- or comma-separated Google `sub` values seeded as admins.
PLATFORM_ADMIN_GOOGLE_SUBS=

PLATFORM_WEB_ORIGIN=https://games.example.com
# One wildcard domain every world is addressed under, whatever its game.
PLATFORM_SERVERS_DOMAIN=servers.example.com

# --- TLS (tls profile; see README's TLS section) ---
# Only read when "tls" is in COMPOSE_PROFILES. Off by default because Caddy
# crash-loops on ACME until DNS points here and 80/443 are open. Enabling TLS
# also means https URLs above, PLATFORM_COOKIE_SECURE=true, and the https
# callback in the Google console -- otherwise the padlock works and login does not.
PUBLIC_DOMAIN=games.example.com
ACME_EMAIL=you@example.com
# Set to the staging directive while DNS settles; empty for real certificates.
# ACME_CA_DIRECTIVE=acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA_DIRECTIVE=

# ==========================================================================
# The host
# ==========================================================================

# Which optional parts of the stack run here: each game's router (see its
# section below) and "tls". Which games people can create worlds for is
# chosen in the web UI (Admin > Settings > Games), and a game can only be
# turned on there while its router's profile is listed here.
COMPOSE_PROFILES=minecraft

# Where world data, backup staging and runtime config live. Kept off the
# service account's home so world data (written by untrusted containers) does
# not sit beside dotfiles and SSH keys. `sudo scripts/host-config.sh --apply`
# creates it with the right (remapped) owner.
PLATFORM_DATA_ROOT=/var/lib/open-worlds
# uid/gid the api, worker and every world container run as. compose passes
# them through as PLATFORM_RUN_UID/_GID (the api refuses the pre-merge
# PLATFORM_MC_RUN_UID/_GID names).
PUID=1000
PGID=1000
# Each game's card artwork, which you supply: see game-art/README.md.
# GAME_ART_DIR=./game-art

# The app edge (HTTP), for the outer proxy that terminates TLS. api and web
# have no published ports; they are reached only through the edge.
EDGE_PORT=18080
# Set EDGE_BIND=0.0.0.0 when the outer proxy is another machine. Published ports
# bypass ufw, so the DOCKER-USER block in host/ufw/ then limits the edge port to
# EDGE_ALLOW_FROM on HOST_IFACE; scripts/host-config.sh renders and checks it.
#EDGE_BIND=0.0.0.0
# Also the one address whose X-Forwarded-For the edge takes as the client's.
EDGE_ALLOW_FROM=192.0.2.10
HOST_IFACE=eth0
# Peers whose X-Forwarded-* headers the api trusts: the edge's static address.
# PLATFORM_FORWARDED_ALLOW_IPS=172.28.0.2

# Grafana's break-glass port, for when the api is down: bind it to this host
# only, never a public interface, and reach it through an SSH tunnel.
LAN_BIND=127.0.0.1

PLATFORM_LOG_LEVEL=INFO
PLATFORM_LOG_JSON=true
# false only for local HTTP dev; must be true anywhere the session cookie
# travels over a network.
PLATFORM_COOKIE_SECURE=true

# ==========================================================================
# Worlds (every game)
# ==========================================================================

# Ceiling for any one world. Size it to the host: worlds are not swapped out,
# and several may run at once.
PLATFORM_MAX_MEMORY_MB=12288
# Floor: a world below this will not boot, so creation/edit is refused rather
# than leaving the owner with a world that silently fails to start.
PLATFORM_MIN_MEMORY_MB=1024
# What a *new* world gets is per-game and normally left unset: each game
# declares its own, because the number is not comparable across games (reserved
# heap for one, a ceiling for another). Uncomment to force one figure on all.
# PLATFORM_DEFAULT_MEMORY_MB=6144
# Total memory (MB) for world containers at once, counting sleeping worlds
# (a player connecting wakes them). A start past it is refused rather than
# leaving the kernel to pick a victim. Unset, anyone who can wake a world can
# oversubscribe the host. Size it to physical RAM minus the OS, Docker, the
# control plane and Postgres (about 5 GB), above PLATFORM_MAX_MEMORY_MB.
PLATFORM_HOST_MEMORY_BUDGET_MB=24576
# CPU cores each world container may use (fractional allowed). 0 = uncapped.
# With 8 cores and up to 3 worlds at once, 2.5 leaves room for the control plane.
PLATFORM_CONTAINER_CPUS=0
PLATFORM_MAX_WORLDS_PER_USER=10
# A world with nobody on it for this long is put to sleep (seconds).
# PLATFORM_AUTO_STOP_AFTER_SECONDS=600
# After a world starts, how long before the idle timer may put it back to
# sleep. Must exceed the slowest game's boot, or a woken world sleeps before
# anyone joins.
PLATFORM_WAKE_GRACE_SECONDS=180

# ==========================================================================
# Egress: what world containers may reach
# ==========================================================================
# The policy itself is deliberately not here: each game's ALLOW/DENY lives in
# games/<game>/egress.py, in code, under review. A security boundary that can
# be widened by editing an untracked .env is one an attacker widens first.

# Every world runs beside an egress guard: it answers only the names its game's
# policy allows and, with blocking on, rejects every other outbound connection;
# with blocking off it records them and blocks nothing. Build the image first,
# and rebuild it after editing a policy: docker compose --profile guard build egress-guard
#
# Whether a NEW world starts with blocking on. Each world keeps its own value.
PLATFORM_EGRESS_BLOCKING_DEFAULT=false
# Who may change a world's blocking in its settings ("Allow unknown network
# connections"): none (default; setting hidden), admin, or owner_and_manager.
PLATFORM_EGRESS_OVERRIDE_ACTORS=none
# Emergency switch, normally left alone: false removes every guard at each
# world's next start, for when the guard itself is what keeps worlds down.
PLATFORM_EGRESS_GUARD_ENABLED=true
# PLATFORM_EGRESS_GUARD_IMAGE=open-worlds-egress-guard:latest

# Resolver for world containers: the dns-observer, which records the names
# worlds ask for. The orchestrator appends the fallback, so a dead observer costs
# a slow first lookup rather than a world that resolves nothing. Empty keeps
# Docker's own resolver and records no names.
PLATFORM_WORLD_DNS=172.19.255.53
PLATFORM_WORLD_DNS_FALLBACK=1.1.1.1
# Where the dns-observer binds on the games network. Must sit inside
# PLATFORM_GAMES_SUBNET and not collide with a world container.
PLATFORM_DNS_OBSERVER_IP=172.19.255.53
# Upstream the dns-observer forwards to.
PLATFORM_DNS_UPSTREAM=1.1.1.1
# PLATFORM_DNS_WRITE_SECONDS=30

# The `games` network's subnet (`docker network inspect games`): the host
# firewall and the metrics endpoints refuse it.
PLATFORM_GAMES_SUBNET=172.19.0.0/16
# The egress exporter: the guards' refusals as Prometheus metrics.
PLATFORM_EGRESS_METRICS_PORT=9109
# Past this many seconds the dns-observer's report counts as stale and alerts.
# PLATFORM_EGRESS_STALE_AFTER=300

# ==========================================================================
# Minecraft (compose profile "minecraft": mc-router and its placeholder)
# ==========================================================================

# Host port mc-router listens on: one TCP port for every Minecraft world,
# routed by the hostname in the handshake. Forward it on the router.
MC_ROUTER_PORT=25565
# How long a player's join waits while a sleeping world boots (seconds).
# MC_WAKE_WAIT_SECONDS=180
# Server types offered and the content catalog's limits have built-in defaults
# (api/src/open_worlds/common/games/minecraft/config.py). Changing one here
# also needs a line passing it through in docker-compose.yml.

# ==========================================================================
# Palworld (compose profile "palworld": pal-waker)
# ==========================================================================
# To offer Palworld: add palworld to COMPOSE_PROFILES above, forward the port
# range on the router, `make up`, then turn it on under Admin > Settings > Games.

# One UDP port per Palworld world, and therefore the cap on how many can exist.
# pal-waker publishes the range and the api allocates from it. Forward the whole
# range (UDP) on the router; growing it means forwarding the new ports too.
PLATFORM_GAME_PORT_RANGE_START=8211
PLATFORM_GAME_PORT_RANGE_END=8220
# What it takes for a packet to wake a sleeping world, since the internet sends
# lone UDP probes to every open port. A wake needs this many datagrams from one
# source within the window (a retrying client does this; a scanner does not),
# and a port that just woke its world will not again within the cooldown.
PLATFORM_WAKE_MIN_DATAGRAMS=3
PLATFORM_WAKE_WINDOW_SECONDS=10
PLATFORM_WAKE_COOLDOWN_SECONDS=300
# true recovers from a backwards clock step (Pal.AllowNegativeDeltaTime=1)
# instead of segfaulting. Only for a host whose clock steps back; the RUNBOOK's
# "The host" section has a check.
PLATFORM_PALWORLD_ALLOW_NEGATIVE_DELTA_TIME=false
