{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "title": "Open Worlds",
  "uid": "open-worlds",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Worlds by state",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "pal_worlds_by_state",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Jobs pending",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "pal_jobs_pending"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "World actions (rate)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (action, result) (rate(pal_world_actions_total[5m]))",
          "legendFormat": "{{action}} {{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Backups (rate)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (kind, result) (rate(pal_backups_total[15m]))",
          "legendFormat": "{{kind}} {{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Backup duration p95 (s)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(pal_backup_duration_seconds_bucket[1h])))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Guard refusals no list explains (scripts/egress-refusals.sh lists them)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "egress_refused_unlisted",
          "legendFormat": "unexplained refusals"
        }
      ],
      "id": 1
    },
    {
      "type": "row",
      "title": "World containers",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      }
    },
    {
      "type": "timeseries",
      "title": "World CPU (cores)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"game-world-.*\"}[5m]))",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "World memory",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (name) (container_memory_working_set_bytes{name=~\"game-world-.*\"})",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Infrastructure containers",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 41
      }
    },
    {
      "type": "timeseries",
      "title": "Infra CPU (cores)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "label_replace(sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"open-worlds-.*\"}[5m])), \"service\", \"$1\", \"name\", \"open-worlds-(.*)-[0-9]+\")",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Infra memory",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 42
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "label_replace(sum by (name) (container_memory_working_set_bytes{name=~\"open-worlds-.*\"}), \"service\", \"$1\", \"name\", \"open-worlds-(.*)-[0-9]+\")",
          "legendFormat": "{{service}}"
        }
      ]
    }
  ]
}
